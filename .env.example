# ==========================================
# CONFIGURACIÓN DE DESPLIEGUE EN AWS EC2
# ==========================================

# Puertos expuestos en la máquina virtual de AWS
FRONTEND_PORT=80
BACKEND_PORT=3000
MONGO_PORT=27017

# Credenciales de la Base de Datos MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=TuPasswordSeguroAWS2026!
MONGO_DB_NAME=course_ecommerce_db

# Configuración Interna del Backend
BACKEND_INTERNAL_PORT=3000
JWT_SECRET=TuFirmaSecretaSuperSeguraParaAWSJWT2026!

# Credenciales por defecto para la cuenta Administrador inicial
ADMIN_EMAIL=admin@tusitio.com
ADMIN_PASSWORD=AdminPassAWS2026!

# Integraciones de Pago (Stripe u otros)
STRIPE_SECRET_KEY=sk_test_tu_llave_stripe_aqui

# URL de la API consumida por el Frontend (en Nginx /api redirige internamente)
VITE_API_URL=/api
